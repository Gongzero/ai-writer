# Supabase (로그인)
# https://supabase.com 에서 프로젝트 생성 후 Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase 대시보드 설정 ──
# Authentication → URL Configuration
#   Site URL: http://localhost:3000 (로컬) / https://ai-writer-rust.vercel.app (배포)
#   Redirect URLs:
#     http://localhost:3000/auth/callback
#     https://ai-writer-rust.vercel.app/auth/callback
#
# Authentication → Providers → Google
#   Google Cloud Console OAuth 클라이언트 생성
#   Authorized redirect URI: https://YOUR_PROJECT.supabase.co/auth/v1/callback
#
# Authentication → Providers → Kakao
#   https://developers.kakao.com 앱 생성
#   REST API 키를 Client ID로, Client Secret은 카카오 콘솔에서 활성화 후 입력
#   Redirect URI: https://YOUR_PROJECT.supabase.co/auth/v1/callback
